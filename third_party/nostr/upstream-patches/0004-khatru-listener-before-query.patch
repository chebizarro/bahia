 					// expose subscription id in the context
 					reqCtx = context.WithValue(reqCtx, subscriptionIdKey, env.SubscriptionID)
 
-					// handle each filter separately -- dispatching events as they're loaded from databases
+					// Register all live listeners BEFORE running stored queries.
+					// This ensures a CLOSE arriving during a (possibly slow)
+					// QueryStored call finds the listener and removes it,
+					// instead of leaving it until disconnect.
+					for _, filter := range env.Filters {
+						if filter.IDs == nil {
