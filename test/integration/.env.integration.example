# =============================================================================
# AI Fabric HF/vLLM Production Integration Prerequisites
# =============================================================================
#
# Copy this file to .env.integration and fill in your production values.
# Then run the verification with:
#
#   ./test/integration/run-hf-vllm-verify.sh
#
# Or manually:
#
#   set -a && source test/integration/.env.integration && set +a
#   BAHIA_HF_VLLM_PROD_VERIFY=1 \
#     go test -tags=integration \
#       ./test/integration/ml_hf_vllm_production_verification_test.go \
#       -run TestAIHFVLLMProductionIntegrations -count=1 -v
#
# NOTE: All SHA-256 values must be 64-character lowercase hex digests of the
# downloaded response body bytes (not headers, ETags, or Docker content digests).
# Compute them with: curl -sL <URL> | sha256sum
#
# =============================================================================

# ---------------------------------------------------------------------------
# Gate control
# ---------------------------------------------------------------------------
# Set to "1" to enable the production verification gate.
# When unset or "0", TestAIHFVLLMProductionIntegrations skips gracefully.
BAHIA_HF_VLLM_PROD_VERIFY=1

# ---------------------------------------------------------------------------
# Hugging Face Artifact
# ---------------------------------------------------------------------------
# HTTPS URL for the exact pinned Hugging Face artifact or snapshot manifest.
# Example: https://huggingface.co/api/models/meta-llama/Llama-3.3-70B-Instruct/revision/main/config.json
BAHIA_HF_ARTIFACT_URL=

# Expected SHA-256 of the downloaded artifact bytes.
# Compute: curl -sL "$BAHIA_HF_ARTIFACT_URL" | sha256sum | cut -d' ' -f1
BAHIA_HF_ARTIFACT_SHA256=

# Optional: Hugging Face API token (for gated models).
# BAHIA_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# vLLM Backend
# ---------------------------------------------------------------------------
# Reachable production vLLM/OpenAI-compatible backend base URL.
# Example: http://gpu-node:8000
BAHIA_VLLM_BASE_URL=

# The model ID that must appear in both vLLM and gateway /v1/models responses.
# Example: meta-llama/Llama-3.3-70B-Instruct
BAHIA_ML_EXPECTED_MODEL_ID=

# Optional: vLLM API key if the backend requires authentication.
# BAHIA_VLLM_API_KEY=

# ---------------------------------------------------------------------------
# ML Gateway
# ---------------------------------------------------------------------------
# Reachable production gateway /v1/models-compatible URL.
# Example: https://ml-gateway.example.com/v1/models
BAHIA_ML_GATEWAY_MODELS_URL=

# Optional: Gateway auth token.
# BAHIA_ML_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# OCI Mirror / Provenance
# ---------------------------------------------------------------------------
# HTTPS OCI manifest or referrers URL for the mirrored model artifact.
# Example: https://registry.example.com/v2/ml-models/llama-70b/manifests/sha256:abc123...
BAHIA_ML_OCI_MANIFEST_URL=

# Expected SHA-256 of the downloaded OCI manifest/provenance response body.
# Compute: curl -sL -H "Accept: application/vnd.oci.image.manifest.v1+json" "$BAHIA_ML_OCI_MANIFEST_URL" | sha256sum | cut -d' ' -f1
BAHIA_ML_OCI_ARTIFACT_SHA256=

# Optional: OCI registry auth token.
# BAHIA_ML_OCI_TOKEN=

# ---------------------------------------------------------------------------
# Blossom Artifact Mirror
# ---------------------------------------------------------------------------
# HTTPS Blossom artifact URL for the mirrored model artifact.
# Example: https://blossom.example.com/abc123...
BAHIA_ML_BLOSSOM_ARTIFACT_URL=

# Expected SHA-256 of the downloaded Blossom artifact response body.
# Compute: curl -sL "$BAHIA_ML_BLOSSOM_ARTIFACT_URL" | sha256sum | cut -d' ' -f1
BAHIA_ML_BLOSSOM_ARTIFACT_SHA256=

# Optional: Blossom auth token.
# BAHIA_ML_BLOSSOM_TOKEN=

# ---------------------------------------------------------------------------
# Nostr Relays
# ---------------------------------------------------------------------------
# Comma-separated production relay URLs for AI fabric read-model verification.
# Example: wss://relay.example.com,wss://relay2.example.com
BAHIA_ML_RELAY_URLS=

# Nostr private key (hex) authorized to publish/subscribe verification events.
# Must support NIP-42 AUTH if the relays require it.
# Generate with: openssl rand -hex 32
BAHIA_ML_RELAY_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional: Timeouts
# ---------------------------------------------------------------------------
# Overall test timeout (default: 45s).
# BAHIA_HF_VLLM_PROD_VERIFY_TIMEOUT=60s
# Per-request HTTP timeout (default: 15s).
# BAHIA_HF_VLLM_HTTP_TIMEOUT=20s
# Relay verification event kind (default: 30078).
# BAHIA_ML_RELAY_VERIFY_KIND=30078
# Relay verification event expiration (default: 24h).
# BAHIA_ML_RELAY_VERIFY_EXPIRATION=24h
