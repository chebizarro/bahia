# Local development overrides for docker-compose.yml.
# Defaults in internal/config/config.go are production-safe; the values below
# intentionally bind containers to all interfaces and use the bundled Postgres.

# Daemon HTTP listener
BAHIA_SERVER_HOST=0.0.0.0
BAHIA_SERVER_PORT=8080
BAHIA_SERVER_READ_TIMEOUT=30s
BAHIA_SERVER_WRITE_TIMEOUT=30s
BAHIA_SERVER_SHUTDOWN_TIMEOUT=15s

# Bundled development database (code defaults: password empty, sslmode=require)
BAHIA_DB_HOST=postgres
BAHIA_DB_PORT=5432
BAHIA_DB_USER=bahia
BAHIA_DB_PASSWORD=bahia
BAHIA_DB_NAME=bahia
BAHIA_DB_SSLMODE=disable
BAHIA_DB_MAX_OPEN_CONNS=25
BAHIA_DB_MAX_IDLE_CONNS=5
BAHIA_DB_CONN_MAX_LIFETIME=5m

# Service identity and operator authority
BAHIA_NOSTR_PRIVATE_KEY=
BAHIA_NOSTR_AUTHORIZED_PUBKEYS=
BAHIA_NOSTR_SERVICE_RELAYS=
BAHIA_NOSTR_BROWSER_RELAYS=ws://localhost:3000/relay
BAHIA_NOSTR_CONTEXTVM_RELAYS=ws://localhost:3000/relay
BAHIA_NOSTR_RELAY_AUTH_UNAVAILABLE=exclude_and_fail
BAHIA_NOSTR_PUBLISH_ENABLED=true
BAHIA_NOSTR_STALE_RUN_AFTER=5m
# Nested sidecar keys use an explicit double underscore between levels.
BAHIA_NOSTR__SIDECAR__READ_AUTH_MODE=enforce

# Reconciliation and local runtime
BAHIA_RECONCILE_INTERVAL=60s
BAHIA_RECONCILE_ENABLED=true
BAHIA_RUNTIME_TYPE=docker
BAHIA_RUNTIME_DOCKER_HOST=unix:///var/run/docker.sock

# Logging and HTTP authentication
BAHIA_LOG_LEVEL=info
BAHIA_LOG_FORMAT=json
BAHIA_AUTH_ENABLED=false

# Host GID that owns /var/run/docker.sock. The Bahia container runs non-root
# and joins this numeric group to reach the socket:
#   stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=999

# The web entrypoint writes these trust roots into /bahia-bootstrap.js.
PUBLIC_BAHIA_BOOTSTRAP_RELAYS=ws://localhost:3334/relay
PUBLIC_BAHIA_SERVICE_PUBKEYS=
# Optional operations-widget publisher allowlist; empty denies every publisher.
PUBLIC_WHEELHOUSE_ALLOWED_PUBKEYS=
