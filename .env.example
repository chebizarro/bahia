# Bahia Deployment Registry - Environment Configuration

# Server
BAHIA_SERVER_HOST=0.0.0.0
BAHIA_SERVER_PORT=8080
BAHIA_SERVER_READ_TIMEOUT=30s
BAHIA_SERVER_WRITE_TIMEOUT=30s
BAHIA_SERVER_SHUTDOWN_TIMEOUT=15s

# Database
BAHIA_DB_HOST=localhost
BAHIA_DB_PORT=5432
BAHIA_DB_USER=bahia
BAHIA_DB_PASSWORD=bahia
BAHIA_DB_NAME=bahia
BAHIA_DB_SSLMODE=disable
BAHIA_DB_MAX_OPEN_CONNS=25
BAHIA_DB_MAX_IDLE_CONNS=5
BAHIA_DB_CONN_MAX_LIFETIME=5m

# Harbor
BAHIA_HARBOR_URL=https://harbor.example.com
BAHIA_HARBOR_USERNAME=admin
BAHIA_HARBOR_PASSWORD=
BAHIA_HARBOR_INSECURE=false

# Loom
BAHIA_LOOM_RELAYS=wss://relay.damus.io,wss://nos.lol
BAHIA_LOOM_JOB_TIMEOUT=30m
BAHIA_LOOM_POLL_INTERVAL=10s

# Nostr
BAHIA_NOSTR_PRIVATE_KEY=
BAHIA_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
BAHIA_NOSTR_PUBLISH_ENABLED=true

# Reconciliation
BAHIA_RECONCILE_INTERVAL=60s
BAHIA_RECONCILE_ENABLED=true

# Runtime (Docker)
BAHIA_RUNTIME_TYPE=docker
BAHIA_RUNTIME_DOCKER_HOST=unix:///var/run/docker.sock

# Logging
BAHIA_LOG_LEVEL=info
BAHIA_LOG_FORMAT=json

# Auth (optional)
BAHIA_AUTH_ENABLED=false
BAHIA_AUTH_JWT_SECRET=
