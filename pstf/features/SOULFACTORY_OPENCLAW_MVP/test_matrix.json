{
  "feature_id": "SOULFACTORY_OPENCLAW_MVP",
  "tests": [
    {
      "id": "SFOM-T-001",
      "name": "SoulFactory defaults disabled",
      "command": "go test ./internal/config -run TestDefaults",
      "criteria": ["SFOM-AC-001"]
    },
    {
      "id": "SFOM-T-002",
      "name": "SoulFactory YAML/env config loads and normalizes",
      "command": "go test ./internal/config -run TestLoadSoulFactoryConfigFromYAMLAndEnv",
      "criteria": ["SFOM-AC-002"]
    },
    {
      "id": "SFOM-T-003",
      "name": "Invalid SoulFactory config rejects missing/invalid required fields",
      "command": "go test ./internal/config -run TestLoadRejectsInvalidSoulFactoryConfig",
      "criteria": ["SFOM-AC-002"]
    },
    {
      "id": "SFOM-T-004",
      "name": "App startup leaves SoulFactory unconstructed when disabled",
      "command": "go test ./internal/app -run TestNewDoesNotRegisterSoulFactoryWhenDisabled",
      "criteria": ["SFOM-AC-003"]
    },
    {
      "id": "SFOM-T-005",
      "name": "App startup registers enabled SoulFactory reactor/OpenClaw adapter",
      "command": "go test ./internal/app -run TestNewRegistersSoulFactoryWhenEnabled",
      "criteria": ["SFOM-AC-004"]
    },
    {
      "id": "SFOM-T-006",
      "name": "App startup rejects invalid enabled SoulFactory config before construction",
      "command": "go test ./internal/app -run TestNewRejectsInvalidSoulFactoryConfig",
      "criteria": ["SFOM-AC-005"]
    },
    {
      "id": "SFOM-T-007",
      "name": "No SoulFactory REST route added in Item 1",
      "command": "! grep -R \"soul_factory\\|soulfactory\" internal/api",
      "criteria": ["SFOM-AC-006"],
      "expected": "No SoulFactory provisioning/lifecycle REST handlers under internal/api."
    },
    {
      "id": "SFOM-T-008",
      "name": "Provisioning publications use normalized combined relays and return publish errors",
      "command": "go test ./internal/soulfactory -run TestProvisioningPublicationUsesNormalizedCombinedRelaysAndSurfacesErrors",
      "criteria": ["SFOM-AC-007"]
    },
    {
      "id": "SFOM-T-009",
      "name": "Runtime result fields land before final 31951 and terminal 7950",
      "command": "go test ./internal/soulfactory -run TestDraftBackedRuntimeProvisioningPublishesFinalSoulWithResolvedFields",
      "criteria": ["SFOM-AC-008"]
    },
    {
      "id": "SFOM-T-010",
      "name": "Bahia projection does not create synthetic initial deployables",
      "command": "go test ./internal/soulfactory -run TestBahiaIntegrationDoesNotCreateSyntheticInitialDeployment",
      "criteria": ["SFOM-AC-009"]
    },
    {
      "id": "SFOM-T-011",
      "name": "Bahia projection creates deployment only from opt-in runtime artifact metadata",
      "command": "go test ./internal/soulfactory -run TestBahiaIntegrationCreatesInitialDeploymentFromRuntimeArtifactMetadata",
      "criteria": ["SFOM-AC-009"]
    },
    {
      "id": "SFOM-T-012",
      "name": "Bahia runtime artifact opt-in requires digest metadata",
      "command": "go test ./internal/soulfactory -run TestBahiaIntegrationRuntimeArtifactOptInRequiresDigestMetadata",
      "criteria": ["SFOM-AC-009"]
    },
    {
      "id": "SFOM-T-013",
      "name": "Runtime provisioning failure publishes error without final soul or success result",
      "command": "go test ./internal/soulfactory -run TestRuntimeProvisionFailurePublishesErrorWithoutFinalSoulOrSuccess",
      "criteria": ["SFOM-AC-008"]
    }
  ]
}
