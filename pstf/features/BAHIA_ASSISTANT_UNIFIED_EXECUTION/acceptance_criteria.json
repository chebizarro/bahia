{
  "feature_id": "BAHIA_ASSISTANT_UNIFIED_EXECUTION",
  "criteria": [
    {
      "id": "A1",
      "claim": "Closed workflow, phase and work-state enums with v2 session and interface contracts",
      "tests": [
        "TestAssistantExecutionEnumsAndPlanValidation"
      ],
      "owner": "item_1"
    },
    {
      "id": "A2",
      "claim": "Nil versus empty AllowedTools survives JSON and nested scope/work arguments cannot alias",
      "tests": [
        "TestAssistantAllowedToolsRoundTripAndDeepClone"
      ],
      "owner": "item_1"
    },
    {
      "id": "A3",
      "claim": "Batch approval RFC 8785 bytes and SHA-256 match shared Go/browser vectors",
      "tests": [
        "TestAssistantBatchApprovalGoldenVectors",
        "web/tests/unit/assistant/assistant-contract.test.js",
        "TestAssistantJCSRFC8785NumberSamples",
        "TestAssistantIJSONRejectsDuplicateKeysAndLoneSurrogates",
        "TestAssistantApprovalScopeArgumentCommitmentVector"
      ],
      "owner": "item_1_and_4"
    },
    {
      "id": "A4",
      "claim": "Every historical class is deterministic and no single field grants executable authority",
      "tests": [
        "TestClassifyAssistantLegacySessionMatrix",
        "TestClassifyAssistantLegacySessionRejectsSourceMismatch",
        "TestClassifyAssistantLegacyBatchDraftKeepsSeparateHashes"
      ],
      "owner": "item_1"
    },
    {
      "id": "A5",
      "claim": "Both workflows use one durable executor with fail-closed checkpoints and receipt accounting",
      "tests": [
        "TestAssistantUnifiedExecutionIntegration",
        "TestAssistantExecutionStoreEncryptedChainIgnoresArrivalAndTimestamp",
        "TestAssistantCheckpointChainRejectsForkGapAndDisconnectedRoot",
        "TestAssistantCheckpointRetryWithDifferentPayloadIsRefused",
        "TestAssistantExecutionCheckpointFailureAtEveryBoundaryBlocksSafely",
        "TestAssistantExecutionRelayRejectedReservationPreventsDispatch"
      ],
      "owner": "items_2_and_3"
    },
    {
      "id": "A6",
      "claim": "Browser edits bind revision and hash, cancellation is run-bound, v1 controls are read-only",
      "tests": [
        "web/tests/unit/assistant/assistant-contract.test.js",
        "web/tests/e2e/assistant-unified-execution.spec.js"
      ],
      "owner": "item_4"
    },
    {
      "id": "A7",
      "claim": "A sync -> async -> sync batch and a multi-call iterative response resume after reconstructing every service and execute each eligible item exactly once without dropping the tail",
      "tests": [
        "TestAssistantExecutionBatchSyncAsyncSyncResumesAfterFullRestartExactlyOnce",
        "TestAssistantExecutionIterativeMultiCallTailSurvivesSuspensionAndRestart"
      ],
      "owner": "item_2"
    },
    {
      "id": "A8",
      "claim": "Replayed terminal events and replayed consumption do not duplicate observations or transcript entries, open extra observers, or advance the cursor twice",
      "tests": [
        "TestAssistantExecutionReplayedTerminalEventsDoNotDuplicate",
        "TestAssistantExecutionConsumeReplayAfterTranscriptAppendIsIdempotent",
        "TestAssistantTranscriptAppendOnceIsIdempotentAndDedupeIsOrderIndependent"
      ],
      "owner": "item_2"
    },
    {
      "id": "A9",
      "claim": "Cancellation during model work, dispatch, observation and restart prevents successors while retaining submitted-effect accounting; stale targets cannot stop a newer run",
      "tests": [
        "TestAssistantExecutionCancellationDuringModelWorkDiscardsLateProposal",
        "TestAssistantExecutionCancellationDuringDispatchKeepsAccounting",
        "TestAssistantExecutionCancellationDuringObservationSurvivesRestart",
        "TestAssistantExecutionCancellationScopesAndStaleTargets"
      ],
      "owner": "item_2"
    },
    {
      "id": "A10",
      "claim": "A receipt-less dispatching item becomes uncertain, is never replayed, blocks successors and resolves only through verified request-event evidence",
      "tests": [
        "TestAssistantExecutionMissingReceiptBecomesUncertainAndReconcilesWithoutReplay",
        "TestAssistantRequestEvidenceProvesExactSubmissionOnly"
      ],
      "owner": "item_2"
    },
    {
      "id": "A11",
      "claim": "Hooks tighten but never loosen, changed approved input never executes, batch approval stays mandatory, action approval binds one work item, and nil/empty AllowedTools hold across workflows and restart",
      "tests": [
        "TestAssistantExecutionHookChangingApprovedInputNeverExecutesUnreviewedContent",
        "TestAssistantRuntimeHooksTightenButNeverLoosen",
        "TestAssistantRuntimeApprovalBindsExactIterativeWorkAndBatchNeedsApproval",
        "TestAssistantExecutionIterativeActionApprovalBindsExactWork",
        "TestAssistantExecutionAllowedToolsNilVersusEmptyAcrossWorkflowsAndRestart",
        "TestAssistantCheckpointPreservesNilVersusEmptyAllowedTools"
      ],
      "owner": "item_2"
    },
    {
      "id": "A12",
      "claim": "Observation keeps one scoped backfill-plus-live subscription per receipt; EOSE never completes it; CLOSED/AUTH blocks (projection only) and reissues; provenance is validated",
      "tests": [
        "TestAssistantExecutionObserverKeepsLiveSubscriptionAfterEOSE",
        "TestAssistantExecutionObserverClosedAndAUTHBlockThenReissue",
        "TestAssistantExecutionObserverValidatesProvenance",
        "TestAssistantExecutionObservationBlockedIsVolatileAndReissues"
      ],
      "owner": "item_2"
    },
    {
      "id": "A13",
      "claim": "v2 session projections have strictly increasing created_at per session, including same-second transitions and across restarts",
      "tests": [
        "TestAssistantExecutionProjectionCreatedAtStrictlyIncreasesAcrossRestart"
      ],
      "owner": "item_2"
    },
    {
      "id": "A14",
      "claim": "Recovery is one path: v1 history converts once through the pure classifier; accounting-only conversions never dispatch or reason; ambiguous history parks",
      "tests": [
        "TestAssistantRecoveryConvertsV1IterativeWaitingAsyncForAccountingOnly",
        "TestAssistantRecoveryConvertsV1BatchDraftForV2Approval",
        "TestAssistantRecoveryParksAmbiguousHistory"
      ],
      "owner": "item_2"
    }
  ]
}
